{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glossframe-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glossframe-local",
      "database_id": "local-db",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "local-images",
      "remote": false
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "APP_NAME": "GlossFrame",
    "DEFAULT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "WORD_MODEL": "@cf/zai-org/glm-4.7-flash",
    "FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash",
    "SESSION_DAYS": "30",
    "OWNER_SETUP_DISABLED": "false"
  },
  "workers_dev": false,
  "preview_urls": false
}
