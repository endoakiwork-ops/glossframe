{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/worker",
    "src/shared",
    "tests"
  ],
  "exclude": [
    "tests/audio.test.ts",
    "tests/api-stream.test.ts",
    "tests/ocr-preload.test.ts"
  ]
}
